# Servidor de desarrollo
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000

# Define credenciales propias en Backend/.env; nunca publiques ese archivo.
ADMIN_USERNAME=replace-with-your-admin-user
ADMIN_PASSWORD=replace-with-a-long-unique-secret

# PostgreSQL: completa estos campos para persistir inventario, pedidos y ventas.
POSTGRESQL_ADDON_HOST=
POSTGRESQL_ADDON_PORT=5432
POSTGRESQL_ADDON_DB=
POSTGRESQL_ADDON_USER=
POSTGRESQL_ADDON_PASSWORD=

# Google Drive (subida de imágenes). Si se deja vacío, se guardan en Backend/uploads.
# Son secretos: solo en el backend, nunca en el frontend ni en GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# Pasarela de pagos: el banco/proveedor debe emitir estas credenciales y documentar
# su API, URLs de retorno, webhooks, moneda y marcas admitidas antes de habilitarla.
# PAYMENT_PROVIDER=
# PAYMENT_API_URL=
# PAYMENT_PUBLIC_KEY=
# PAYMENT_SECRET_KEY=
# PAYMENT_WEBHOOK_SECRET=
